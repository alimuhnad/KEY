world EnumExample {
 enum Result<T,E>{Ok(T);Err(E);}
 fn divide(a:Int,b:Int)->Result<Int,Text>{
  if(b==0){return Result<Int,Text>.Err("division by zero");}
  return Result<Int,Text>.Ok(a/b);
 }
 action Main(){
  match divide(84,2){
   Result<Int,Text>.Ok(value)=>{assert(value==42);}
   Result<Int,Text>.Err(message)=>{assert(false);}
  }
 }
}
