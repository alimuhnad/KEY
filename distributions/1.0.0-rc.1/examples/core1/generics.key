world GenericsExample {
 struct Pair<T,U>{first:T;second:U;}
 fn passValue<T>(value:T)->T{return value;}
 action Main(){
  let pair=Pair<Int,Text>{first:42,second:"KEY"};
  assert(passValue<Int>(pair.first)==42);
  let data=own<Int>(1u);mem_set(data,0u,12);
  let moved=passValue<Own<Int>>(data);assert(mem_get(moved,0u)==12);
 }
}
