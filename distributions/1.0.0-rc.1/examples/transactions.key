world Ledger {
    entity Account { balance: Int = 0; }
    event BalanceChanged { account: Account; before: Int; after: Int; }
    rule Nonnegative { invariant all a: Account { a.balance >= 0 }; }

    action Withdraw(account: Account, amount: Int) {
        require amount >= 0;
        let old = account.balance;
        change account.balance = old - amount;
        emit BalanceChanged {account: account, before: old, after: account.balance};
    }

    action Main() {
        let a = create Account {balance: 100};
        assert(!attempt Withdraw(a, 150));
        assert(a.balance == 100);
        assert(event_count(BalanceChanged) == 0);
        assert(attempt Withdraw(a, 30));
        assert(a.balance == 70);
        assert(event_get(BalanceChanged, 0, after) == 70);
        unsafe {
            sys_write_byte(Byte(75)); sys_write_byte(Byte(69));
            sys_write_byte(Byte(89)); sys_write_byte(Byte(32));
            sys_write_byte(Byte(79)); sys_write_byte(Byte(75));
            sys_write_byte(Byte(10));
        }
    }
}
