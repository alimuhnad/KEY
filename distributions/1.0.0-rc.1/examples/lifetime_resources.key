world Lifetimes {
    struct Pair<life a,life b> { first:Ref<Int,a>; second:Ref<Int,b>; }
    struct Packet { bytes:Own<Byte>; label:Ref<Int>; }
    struct Ticket drops Finish { code:Int; }
    fn Finish(ticket:Ref<Ticket>) { assert((*ticket).code==42); }
    fn PairOf<life a,life b>(a:Ref<Int,a>,b:Ref<Int,b>)->Pair<a,b> {
        return Pair{first:a,second:b};
    }
    fn Identity<life a>(p:Ref<Int,a>)->Ref<Int,a> { return p; }
    fn Apply(f:Fn<life a>(p:Ref<Int,a>)->Ref<Int,a>) {
        let value=7;
        let result=f(&value);
        assert(*result==7);
    }
    fn Permanent()->Ref<Int,static> { return static_ref(42); }
    action Main() {
        Apply(fn_ref(Identity));
        var a=11; var b=22;
        let pair=PairOf(&a,&b);
        let first=pair.first;
        assert(*first==11);
        a=33;
        let second=pair.second;
        assert(*second==22);
        let packet=Packet{bytes:own<Byte>(4u),label:Permanent()};
        let moved=packet;
        assert(*moved.label==42);
        drop(moved);
        let ticket=Ticket{code:42};
    }
}
