world Transfers {
    entity Buffer { data:Own<Int>; value:Int; }
    fn Reference(b:Buffer)->WorldRef<Int> { return world_ref(b.value); }
    action Rejected(b:Buffer) {
        let data=world_take(b.data);
        mem_set(data,0u,99);
        drop(data);
        require false;
    }
    callback action Add(value:Int)->Bool {
        require value>=0;
        let data=own<Int>(1u);
        mem_set(data,0u,value);
        let b=create Buffer{data:data,value:value};
        return true;
    }
    action Main() {
        let data=own<Int>(1u);
        mem_set(data,0u,7);
        let b=create Buffer{data:data,value:3};
        let reference=Reference(b);
        world_set(reference,5);
        assert(world_get(reference)==5);
        assert(!attempt Rejected(b));
        assert(mem_get(b.data,0u)==7);
        let extracted=world_take(b.data);
        assert(!world_has(b.data));
        drop(extracted);
        checkpoint();
        assert(owner_count()==0);
    }
}
